<?xml version="1.0" encoding="utf-8"?>
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="sharedpref" path="airchat_identity.xml" />
        <exclude domain="sharedpref" path="airchat_messages.xml" />
        <exclude domain="sharedpref" path="airchat_peer_trust.xml" />
        <exclude domain="sharedpref" path="airchat_peer_blocks.xml" />
        <exclude domain="sharedpref" path="airchat_room_preferences.xml" />
        <exclude domain="sharedpref" path="airchat_received_files.xml" />
        <exclude domain="sharedpref" path="airchat_courier.xml" />
        <exclude domain="file" path="received-files/" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="airchat_identity.xml" />
        <exclude domain="sharedpref" path="airchat_messages.xml" />
        <exclude domain="sharedpref" path="airchat_peer_trust.xml" />
        <exclude domain="sharedpref" path="airchat_peer_blocks.xml" />
        <exclude domain="sharedpref" path="airchat_room_preferences.xml" />
        <exclude domain="sharedpref" path="airchat_received_files.xml" />
        <exclude domain="sharedpref" path="airchat_courier.xml" />
        <exclude domain="file" path="received-files/" />
    </device-transfer>
</data-extraction-rules>
